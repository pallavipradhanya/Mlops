# Copy to .env only if you need to override defaults. Everything works without it.
# --- Backend (non-Docker run) ---
# MLOPS_HOME=C:/dev/mlops360                       # project root (defaults to the repo root)
# DATABASE_URL=sqlite:///C:/dev/mlops360/artifacts/mlops360.db
# MLFLOW_TRACKING_URI=sqlite:///C:/dev/mlops360/artifacts/mlflow.db   # or http://localhost:5000 when using an MLflow server
# MLFLOW_UI_URL=http://localhost:5000
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ENABLE_SCHEDULER=1
# --- Frontend ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
